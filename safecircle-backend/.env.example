# Database Configuration (SQLite default; override with PostgreSQL URL for Neon/Supabase)
DATABASE_URL=sqlite:///./safecircle.db

# Telegram Alert Configuration (Optional; logs graceful fallback if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Threat Triage (Optional; built-in deterministic fallback works offline/without key)
GEMINI_API_KEY=

# Frontend Application URL (Used for Guardian deep links)
FRONTEND_URL=http://localhost:5173

# Server Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
